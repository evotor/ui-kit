<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/dialog_close_button"
        android:layout_width="@dimen/dialog_v2_close_button_size"
        android:layout_height="@dimen/dialog_v2_close_button_size"
        android:layout_marginEnd="@dimen/dialog_close_button_margin"
        android:background="@drawable/bg_dialog_close_button"
        android:scaleType="center"
        android:src="@drawable/ic_close_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_icon_secondary"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/dialog_content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_v2_close_button_margin_top"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="@dimen/dialog_v2_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_close_button"
        tools:background="@drawable/dialog_v2_bottom_background">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dialog_v2_drag_handle_margin_top"
            android:layout_marginBottom="@dimen/dialog_v2_drag_handle_margin_bottom"
            android:background="@drawable/bg_drag_handle_dialog_v2" />

        <TextView
            android:id="@+id/dialog_title"
            style="@style/EvotorUITheme.Text.Headline.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dialog_v2_title_margin"
            tools:text="Dialog title" />

        <TextView
            android:id="@+id/dialog_message"
            style="@style/EvotorUITheme.Text.BodyLarge.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dialog_v2_block_vertical_margin"
            android:visibility="gone"
            tools:text="Dialog message"
            tools:visibility="visible" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_first_container"
            style="@style/EvotorUITheme.TextInputLayout.DialogV2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_v2_input_height"
            android:background="@drawable/bg_dialog_v2_input">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_first"
                style="@style/EvotorUITheme.TextInputEditText.DialogV2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                tools:text="First line" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_second_container"
            style="@style/EvotorUITheme.TextInputLayout.DialogV2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_v2_input_height"
            android:layout_marginTop="@dimen/dialog_v2_block_vertical_margin"
            android:background="@drawable/bg_dialog_v2_input">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_second"
                style="@style/EvotorUITheme.TextInputEditText.DialogV2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                tools:text="Second line" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
