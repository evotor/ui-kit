<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="UselessParent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/dialog_close_button"
            android:layout_width="@dimen/bottom_sheet_dialog_close_button_size"
            android:layout_height="@dimen/bottom_sheet_dialog_close_button_size"
            android:layout_gravity="top|end"
            android:layout_marginBottom="@dimen/bottom_sheet_dialog_close_button_margin_top"
            android:layout_marginEnd="@dimen/bottom_sheet_dialog_close_button_margin"
            android:background="@drawable/bg_dialog_close_button"
            android:scaleType="center"
            android:src="@drawable/ic_close"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/dialog_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="@dimen/bottom_sheet_dialog_padding_v2"
        tools:background="@drawable/dialog_v2_bottom_background"
        tools:ignore="UselessParent">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/drag_handle_dialog_v2_margin_top"
            android:layout_marginBottom="@dimen/drag_handle_dialog_v2_margin_bottom"
            android:background="@drawable/bg_drag_handle_dialog_v2" />

        <ImageView
            android:id="@+id/dialog_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_alert_circle_red_48" />

        <TextView
            android:id="@+id/dialog_title"
            style="@style/EvotorUITheme.Text.Headline.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_dialog_title_margin_v2"
            tools:text="Dialog title" />

        <TextView
            android:id="@+id/dialog_message"
            style="@style/EvotorUITheme.Text.BodyLarge.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_dialog_v2_block_vertical_margin"
            android:visibility="gone"
            tools:text="Dialog message"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_first_container"
                style="@style/EvotorUITheme.TextInputLayout.DialogV2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_v2_input_height"
                android:background="@drawable/bg_dialog_v2_input">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_first"
                    style="@style/EvotorUITheme.TextInputEditText.DialogV2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    tools:text="First line" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_second_container"
                style="@style/EvotorUITheme.TextInputLayout.DialogV2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_v2_input_height"
                android:layout_marginTop="@dimen/bottom_sheet_dialog_v2_block_vertical_margin"
                android:background="@drawable/bg_dialog_v2_input">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_second"
                    style="@style/EvotorUITheme.TextInputEditText.DialogV2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    tools:text="Second line" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/dialog_details"
                style="@style/EvotorUITheme.Text.Caption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bottom_sheet_dialog_block_vertical_margin"
                android:gravity="start"
                android:paddingBottom="@dimen/bottom_sheet_dialog_block_vertical_margin"
                android:textColor="@color/text_secondary"
                tools:text="Dialog details" />

        </LinearLayout>

        <TextView
            android:id="@+id/dialog_attention_text"
            style="@style/EvotorUITheme.Text.Body16.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_dialog_padding_new_error_style"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="Закроется через 10"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
