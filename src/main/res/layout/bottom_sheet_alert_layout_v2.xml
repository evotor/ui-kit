<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/dialog_close_button"
        android:layout_width="@dimen/dialog_v2_close_button_size"
        android:layout_height="@dimen/dialog_v2_close_button_size"
        android:layout_marginEnd="@dimen/dialog_close_button_margin"
        android:background="@drawable/bg_dialog_close_button"
        android:scaleType="center"
        android:src="@drawable/ic_close_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_icon_secondary"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/dialog_content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_v2_close_button_margin_top"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="@dimen/dialog_v2_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_close_button"
        tools:background="@drawable/dialog_v2_bottom_background">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dialog_v2_drag_handle_margin_top"
            android:layout_marginBottom="@dimen/dialog_v2_drag_handle_margin_bottom"
            android:background="@drawable/bg_drag_handle_dialog_v2" />

        <ImageView
            android:id="@+id/dialog_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_alert_circle_red_48" />

        <TextView
            android:id="@+id/dialog_title"
            style="@style/EvotorUITheme.Text.Headline.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dialog_v2_title_margin"
            android:gravity="start"
            tools:text="Dialog title, soooooooooooo long" />

        <TextView
            android:id="@+id/dialog_message"
            style="@style/EvotorUITheme.Text.BodyLarge.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            tools:text="Dialog message" />

        <TextView
            android:id="@+id/dialog_details"
            style="@style/EvotorUITheme.Text.Caption2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/bottom_sheet_dialog_block_vertical_margin"
            android:gravity="start"
            android:textColor="@color/text_secondary"
            tools:text="Dialog details" />

        <TextView
            android:id="@+id/dialog_attention_text"
            style="@style/EvotorUITheme.Text.Body16.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_sheet_dialog_padding_new_error_style"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="Закроется через 10"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
