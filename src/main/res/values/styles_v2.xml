    <style name="EvotorUITheme.Button.NewDialog.Primary" parent="EvotorUITheme.Button">
        <item name="android:background">@drawable/btn_dialog_v2_primary_background</item>
        <item name="android:minHeight">@dimen/dialog_v2_button_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/EvotorUITheme.Text.BodyLarge.Strong</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">@dimen/body_large_text_size</item>
        <item name="android:lineHeight">@dimen/body_large_line_height</item>
        <item name="android:lineSpacingExtra">@dimen/body_large_line_spacing_extra</item>
    </style>

    <style name="EvotorUITheme.Button.NewDialog.Secondary" parent="EvotorUITheme.Button">
        <item name="android:background">@drawable/btn_dialog_v2_secondary_background</item>
        <item name="android:minHeight">@dimen/dialog_v2_button_min_height</item>
        <item name="android:textAllCaps">false</item>
